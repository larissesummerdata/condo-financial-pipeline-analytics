# Arquivos de ambiente e segredos (NUNCA versionar)
.env
*.env

# Ambientes virtuais e caches Python
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class

# IDEs e editores
.vscode/
.idea/

# Dados brutos, temporários e analíticos locais
*.pdf
*.duckdb
*.parquet
*.csv
*.xlsx
*.png
*.jpg
*.jpeg

# Ignora o conteúdo de dados mantendo a pasta no projeto via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep